# API Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_access_key_bookease_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_bookease_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example: DATABASE_URL="postgresql://bookease:bookease_password@localhost:5432/bookease_db?schema=public"

# Redis Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Payments (Stripe)
STRIPE_SECRET_KEY=sk_test_stub_key_bookease
STRIPE_WEBHOOK_SECRET=whsec_stub_secret_bookease

# Notifications
EMAIL_PROVIDER=nodemailer
RESEND_API_KEY=re_stub_key_bookease
FROM_EMAIL=no-reply@bookease.com

# Public Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
